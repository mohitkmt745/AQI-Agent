# ─── IBM watsonx.ai ───────────────────────────────────────────────────────────
WATSONX_API_KEY=your_ibm_cloud_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ─── AQI Data API (choose one or both) ───────────────────────────────────────
# WAQI (World Air Quality Index) – https://aqicn.org/api/
WAQI_TOKEN=your_waqi_token_here

# OpenAQ – https://openaq.org/ (no key required for basic use)
OPENAQ_API_KEY=your_openaq_key_here

# ─── App settings ─────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
USE_SAMPLE_FALLBACK=true        # set false to hard-fail when API is down
CHROMA_PERSIST_DIR=./chroma_db
